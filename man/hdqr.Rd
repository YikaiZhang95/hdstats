eps <- rnorm(n, mean = 0, sd = 1)
y <- x \%*\% beta_star + eps
fit <- hdqr(x = x, y = y, tau = 0.5, lam2 = 0.01)
fit
coef(fit, s = fit$lambda[10])[1:8, ]
}
